# Copy to .env and adjust. Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets here.

# Origin of the parking-marketplace-backend-js API. Request paths already include /api
# (they come from the generated types in src/types/api.ts), so don't append it here.
VITE_API_URL=http://localhost:3000

# Clerk publishable key (Dashboard → API keys). Public by design; the secret key stays in the backend.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Google Maps JavaScript API key, used to pick a spot's location (optional: without it the
# form asks for coordinates). Restrict it to your domains (HTTP referrers) in Google Cloud
# Console — browser keys are always visible.
VITE_GOOGLE_MAPS_API_KEY=replace_me

# Optional Map ID (Google Cloud → Map Management), required for the marker style.
# Leave unset in development to use Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
